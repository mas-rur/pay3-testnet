# Point this at your deployed node's public URL (e.g. https://your-app.fly.dev)
NEXT_PUBLIC_RPC_URL=http://localhost:8080

# The faucet's raw private key -- server-side only (no NEXT_PUBLIC_ prefix,
# so it's never sent to the browser). This MUST be the same key you set as
# FAUCET_PRIVATE_KEY on the l1_node host (see ../DEPLOY.md), since the
# faucet needs to spend from that same genesis-funded account.
# Leave unset for local dev if you don't need the faucet page to work.
FAUCET_PRIVATE_KEY=
